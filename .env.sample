# Provider: "openai" or "anthropic"
PROVIDER=openai

# OpenAI API settings
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.3

# Anthropic API settings (used when PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_TEMPERATURE=0.3
ANTHROPIC_MAX_TOKENS=4096

# Translation settings
TARGET_LANGUAGE=Persian (Farsi)
ENABLE_REFINEMENT=false
ENABLE_POSTPROCESS=true

# Glossary & cache (leave empty to disable)
GLOSSARY_PATH=
CACHE_PATH=

# Concurrency & retry
MAX_CONCURRENCY=5
MAX_RETRIES=3
RETRY_BASE_DELAY=1.0

# Chunking settings
CHUNK_MAX_LINES=18
CHUNK_MAX_CHARS=1500
CHUNK_TIME_GAP_MS=2500
CHUNK_CONTEXT_LINES=3

# Reading-speed budget (characters-per-second for translated text)
ENFORCE_CPS=true
CPS_TARGET=13.0
CPS_MIN_CHARS=20
CPS_TOLERANCE=1.2

# Line-kind handling
TRANSLATE_CUES=true
TRANSLATE_LYRICS=true

# Run-level state (Phase 2)
# Rolling story summary: keeps character/context continuity across a long file
# at the cost of one extra summary-update call every N chunks. When enabled,
# the translation cache is bypassed (cached entries don't account for summary).
ENABLE_MEMORY=false
MEMORY_UPDATE_INTERVAL=5
# One-shot tone/register probe before translation begins (1 extra API call).
AUTO_PROBE=false
# Hand-written register description that overrides the probe entirely
# (e.g. "1920s gangster film, slangy English, mixed register").
# REGISTER_OVERRIDE=

# Glossary lifecycle (Phase 3)
# Discover proper nouns / recurring terms in the source and ask the provider
# to propose translations before the main run. Merged with --glossary entries
# (user-supplied entries always win on conflict).
AUTO_GLOSSARY=false
AUTO_GLOSSARY_MIN_OCCURRENCES=3
# After each chunk, verify every glossary term that appears in the source
# also appears (mapped) in the translation; one targeted retry on violation.
ENFORCE_GLOSSARY=true
