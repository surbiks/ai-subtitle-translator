# Provider backend: copilot | codex
#   copilot = chat.completions with non-streaming Responses fallback (default)
#   codex   = streaming-only Responses API (OpenAI-compatible proxy)
PROVIDER=copilot

# OpenAI-compatible connection settings (shared by both providers)
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.3

# API surface for the copilot provider: auto | chat | responses
#   auto      = try chat.completions, fall back to responses if unsupported
#   chat      = force chat.completions (e.g. gpt-5-mini)
#   responses = force the Responses API (e.g. gpt-5.4-mini)
# Ignored when PROVIDER=codex (codex always streams the Responses API).
OPENAI_API_MODE=auto
# Send the temperature parameter? Set false for models that reject it.
OPENAI_SEND_TEMPERATURE=true

# Example codex preset (streaming Responses proxy):
#   PROVIDER=codex
#   OPENAI_BASE_URL=http://localhost:3001/v1
#   OPENAI_MODEL=codex/gpt-5.5
#   OPENAI_SEND_TEMPERATURE=false

# Translation settings
TARGET_LANGUAGE=Persian (Farsi)
ENABLE_REFINEMENT=false
ENABLE_POSTPROCESS=true

# Glossary & cache (leave empty to disable)
GLOSSARY_PATH=
CACHE_PATH=

# Concurrency & retry
MAX_CONCURRENCY=5
MAX_RETRIES=3
RETRY_BASE_DELAY=1.0

# Chunking settings
CHUNK_MAX_LINES=18
CHUNK_MAX_CHARS=1500
CHUNK_TIME_GAP_MS=2500
CHUNK_CONTEXT_LINES=3

# Reading-speed budget (characters-per-second for translated text)
ENFORCE_CPS=true
CPS_TARGET=13.0
CPS_MIN_CHARS=20
CPS_TOLERANCE=1.2

# Line-kind handling
TRANSLATE_CUES=true
TRANSLATE_LYRICS=true

# Run-level state (Phase 2)
# Rolling story summary: keeps character/context continuity across a long file
# at the cost of one extra summary-update call every N chunks. When enabled,
# the translation cache is bypassed (cached entries don't account for summary).
ENABLE_MEMORY=false
MEMORY_UPDATE_INTERVAL=5
# One-shot tone/register probe before translation begins (1 extra API call).
AUTO_PROBE=false
# Hand-written register description that overrides the probe entirely
# (e.g. "1920s gangster film, slangy English, mixed register").
# REGISTER_OVERRIDE=

# Glossary lifecycle (Phase 3)
# Discover proper nouns / recurring terms in the source and ask the provider
# to propose translations before the main run. Merged with --glossary entries
# (user-supplied entries always win on conflict).
AUTO_GLOSSARY=false
AUTO_GLOSSARY_MIN_OCCURRENCES=3
# After each chunk, verify every glossary term that appears in the source
# also appears (mapped) in the translation; one targeted retry on violation.
ENFORCE_GLOSSARY=true

# Resume / retry-failed-chunks
# When a run leaves failed chunks, a per-file status file is saved so a later
# run on the same source retries only those chunks. It is deleted automatically
# once every chunk is translated.
#   auto         = resume a matching status file if present, else fresh (default)
#   fresh        = ignore any status file and translate everything
#   retry_failed = require a status file and retry only failed chunks
RESUME_MODE=auto
# Directory for status files. Leave empty to use a ".translation-status" folder
# next to each source file.
STATUS_DIR=
