# OpenAI API settings
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.3

# API surface: auto | chat | responses
#   auto      = try chat.completions, fall back to responses if unsupported
#   chat      = force chat.completions (e.g. gpt-5-mini)
#   responses = force the Responses API (e.g. gpt-5.4-mini)
OPENAI_API_MODE=auto
# Send the temperature parameter? Set false for models that reject it.
OPENAI_SEND_TEMPERATURE=true

# Translation settings
TARGET_LANGUAGE=Persian (Farsi)
ENABLE_REFINEMENT=false
ENABLE_POSTPROCESS=true

# Glossary & cache (leave empty to disable)
GLOSSARY_PATH=
CACHE_PATH=

# Concurrency & retry
MAX_CONCURRENCY=5
MAX_RETRIES=3
RETRY_BASE_DELAY=1.0

# Chunking settings
CHUNK_MAX_LINES=18
CHUNK_MAX_CHARS=1500
CHUNK_TIME_GAP_MS=2500
CHUNK_CONTEXT_LINES=3
